data: {"type":"content_block_start","index":0,"content_block":{"type":"web_fetch_tool_result","tool_use_id":"srvtoolu_01FetchFixture00000001","content":{"type":"web_fetch_result","url":"https://lumenarc.example/","content":{"type":"document","source":{"type":"text","media_type":"text/plain","data":"Lumen Arc desk lamp. Lights a desk up to 160 cm wide with an even, flicker-free light. Brightness and warmth are set by touch. Steel arm, weighted base. 5-year warranty. US$ 89."},"title":"Lumen Arc desk lamp"},"retrieved_at":"2026-11-20T10:30:00Z"}}}

