data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"## Product\n\nThe Lumen Arc is a desk lamp with a wide, even light. Its page (https://lumenarc.example/) says it lights a desk up to 160 cm wide, is flicker-free, "}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"is set by touch and has a 5-year warranty. It sells for US$ 89.\n\n## Market\n\n"}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"A 2026 test of desk lamps rated it the best pick for long work days (https://deskreview.example/best-desk-lamps-2026). "}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"The usual alternative is a monitor light bar, which lights the keyboard and not the desk.\n"}}

